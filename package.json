{
  "name": "animevault",
  "version": "5.0.0",
  "description": "Personal anime/manga library manager with MAL sync, Nyaa integration, and enhanced HEVC-aware auto-download",
  "main": "main.js",
  "author": "Kike",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/contracts.test.js && node tests/search-matching.test.js && node tests/mal-data.test.js && node tests/mal-backfill.test.js && node tests/state-integrity.test.js && node tests/auto-download-state.test.js && node tests/security-and-parsers.test.js && node tests/filesystem-safety.test.js",
    "build-x64": "electron-builder --win --x64",
    "build-arm64": "electron-builder --win --arm64",
    "build": "electron-builder --win",
    "build-fast": "electron-builder --win --x64 -c.compression=store",
    "build-dir": "electron-builder --win --x64 --dir",
    "build-installer-x64": "electron-builder --win nsis --x64",
    "build-installer-arm64": "electron-builder --win nsis --arm64",
    "build-installer": "electron-builder --win nsis",
    "build-mobile": "node mobile/scripts/build-www.js",
    "build-apk": "node mobile/scripts/build-apk.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "build": {
    "appId": "com.animevault.app",
    "productName": "AnimeVault",
    "compression": "normal",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "autoDownload.js",
      "openrouter.js",
      "index.html",
      "theme-boot.js",
      "renderer/**/*",
      "styles/**/*",
      "package.json",
      "icon.png",
      "luma/**/*",
      "599-*.png",
      "bin/**/*",
      "!dist{,/**/*}",
      "!tests{,/**/*}",
      "!*.md",
      "!BUILD*.bat"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "AnimeVault-${arch}.${ext}",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AnimeVault-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AnimeVault-${arch}.${ext}"
    }
  }
}
