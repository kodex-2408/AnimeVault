{
  "name": "animevault",
  "version": "4.10.1",
  "description": "Personal anime/manga library manager with MAL sync, Nyaa integration, and enhanced HEVC-aware auto-download",
  "main": "main.js",
  "author": "Kike",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64 --arm64",
    "build-x64": "electron-builder --win portable --x64",
    "build-arm64": "electron-builder --win portable --arm64",
    "build-installer": "electron-builder --win nsis --x64 --arm64",
    "build-installer-x64": "electron-builder --win nsis --x64",
    "build-installer-arm64": "electron-builder --win nsis --arm64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.animevault.app",
    "productName": "AnimeVault",
    "files": [
      "main.js",
      "autoDownload.js",
      "preload.js",
      "index.html",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "mpv.exe",
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "AnimeVault-${arch}.exe"
    }
  }
}