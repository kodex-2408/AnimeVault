{
  "name": "tsundoku",
  "version": "5.11.0",
  "description": "Personal anime/manga library manager with MAL sync, Nyaa integration, and enhanced HEVC-aware auto-download",
  "main": "main.js",
  "author": "Kike",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/contracts.test.js && node tests/search-matching.test.js && node tests/mal-data.test.js && node tests/mal-backfill.test.js && node tests/state-integrity.test.js && node tests/auto-download-state.test.js && node tests/security-and-parsers.test.js && node tests/filesystem-safety.test.js && node tests/library-layout.test.js && node tests/renderer-store.test.js && node tests/playback-and-tracking.test.js && node tests/file-ops.test.js && node tests/luma-openrouter.test.js && node tests/manga-reading.test.js && node tests/manga-translation.test.js && node tests/donghua-filter.test.js",
    "build-x64": "electron-builder --win portable --x64",
    "build-arm64": "electron-builder --win zip --arm64",
    "build": "npm run build-x64 && npm run build-arm64",
    "build-fast": "electron-builder --win --x64 -c.compression=store",
    "build-dir": "electron-builder --win --x64 --dir",
    "build-installer-x64": "electron-builder --win nsis --x64",
    "build-installer-arm64": "electron-builder --win nsis --arm64",
    "build-installer": "npm run build-installer-x64 && npm run build-installer-arm64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^6.4.299"
  },
  "build": {
    "appId": "com.animevault.app",
    "productName": "Tsundoku",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "autoDownload.js",
      "openrouter.js",
      "index.html",
      "theme-boot.js",
      "renderer/**/*",
      "styles/**/*",
      "package.json",
      "icon.png",
      "luma/**/*",
      "fonts/**/*",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders}{,/**/*}",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox*}",
      "!node_modules/onnxruntime-web/{lib,docs,types.d.ts}{,/**/*}",
      "!node_modules/onnxruntime-web/dist/*.map",
      "!node_modules/onnxruntime-web/dist/*.js",
      "!node_modules/onnxruntime-web/dist/ort.{all,webgl,wasm,jspi,bundle,min,node}*",
      "!node_modules/onnxruntime-web/dist/ort.webgpu.{mjs,bundle.min.mjs}",
      "!node_modules/onnxruntime-web/dist/ort.mjs",
      "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{wasm,mjs,jsep.wasm,jsep.mjs,jspi.wasm,jspi.mjs}",
      "!node_modules/onnxruntime-web/dist/*.{d.ts,cjs}",
      "!dist{,/**/*}",
      "!tests{,/**/*}",
      "!*.md",
      "!BUILD*.bat"
    ],
    "win": {
      "icon": "icon.png",
      "artifactName": "Tsundoku-${arch}.${ext}",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Tsundoku-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Tsundoku-${arch}.${ext}"
    }
  }
}
